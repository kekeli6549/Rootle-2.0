# Copy to server/.env for local development.
# On Vercel, add these as Project Settings -> Environment Variables instead.

PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://your-client-deployment.vercel.app
SUPERADMIN_PASSWORD=choose-a-strong-password
